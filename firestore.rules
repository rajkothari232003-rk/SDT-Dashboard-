rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kite credentials & session: server functions only (Admin SDK bypasses rules)
    match /kite/{doc} { allow read, write: if false; }
    match /kiteInstr/{doc} { allow read: if request.auth != null; allow write: if false; }
    // everything else: any signed-in (anonymous) app user
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
